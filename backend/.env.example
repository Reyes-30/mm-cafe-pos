# ============================================
# M&M Café - Configuración del servidor
# ============================================
# Copia este archivo como .env y ajusta los valores

# Puerto del servidor (default: 4000)
PORT=4000

# Entorno: development | production
NODE_ENV=production

# ============================================
# Base de datos PostgreSQL
# ============================================
# Formato: postgresql://USUARIO:CONTRASEÑA@HOST:PUERTO/NOMBRE_BD
DATABASE_URL="postgresql://postgres:TuContraseñaAqui@localhost:5432/mmcafe"

# ============================================
# JWT (Tokens de autenticación)
# ============================================
# Cambia estos valores por cadenas largas y aleatorias
JWT_SECRET="mmcafe-secreto-super-seguro-cambiar-esto-2026"
JWT_REFRESH_SECRET="mmcafe-refresh-secreto-super-seguro-cambiar-esto-2026"
JWT_EXPIRES_IN="8h"
JWT_REFRESH_EXPIRES_IN="7d"

# ============================================
# Frontend URL (para CORS)
# ============================================
FRONTEND_URL="http://localhost:4000"

# ============================================
# Uploads
# ============================================
UPLOAD_DIR="uploads"
MAX_FILE_SIZE=5242880
